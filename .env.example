# Copy to .env and fill in. NEVER commit .env.
GROQ_API_KEY=your_key_here

# Models are tried in order. Check https://console.groq.com/docs/deprecations before relying on one.
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_MAX_CHARS=600
TOP_K=5

# Run `python -m eval.evaluate`, then paste the suggested MIN_SCORE here.
MIN_SCORE=0.0
